{
  "name": "cpe-radar",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS"
  },
  // Runtime secret (do not put the token here): npx wrangler secret put GITHUB_TOKEN
  // Fine-grained PAT, repo blacknet101/cpe-radar, Issues: Read and write.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  // Required by `npx wrangler preview` (Workers Builds branch previews).
  // Empty: previews use the top-level settings. Assets and compatibility stay above.
  "previews": {}
}
